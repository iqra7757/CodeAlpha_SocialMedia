@using CodeAlpha_SocialMedia.Controllers
@using CodeAlpha_SocialMedia.Models
@model dynamic
@{
    ViewData["Title"] = "Search Results";
}

<div class="container-fluid px-5 mt-4" style="background-color: #f9f9f9; min-height: 100vh;">
    <div class="row mb-4">
        <div class="col-12">
            <h5 class="text-dark fw-bold">Showing results for: <span class="text-primary">"@ViewBag.SearchQuery"</span></h5>
            <hr />
        </div>
    </div>

    <div class="row">
        <div class="col-lg-12">
            
            @* --- PEOPLE SECTION --- *@
            @if (ViewBag.Users != null && ((List<User>)ViewBag.Users).Any())
            {
                <div class="mb-5">
                    <h6 class="text-uppercase text-muted small fw-bold mb-3">People</h6>
                    <div class="d-flex overflow-auto pb-3 gap-4">
                        @foreach (var user in (List<User>)ViewBag.Users)
                        {
                            <div class="text-center" style="min-width: 120px;">
                                <div class="bg-white shadow-sm rounded-circle mx-auto mb-2 d-flex align-items-center justify-content-center" style="width: 80px; height: 80px; border: 2px solid #fff;">
                                    <img src="https://ui-avatars.com/api/?name=@user.FullName&background=random" class="rounded-circle" style="width: 70px;">
                                </div>
                                <div class="fw-bold small text-dark text-truncate">@user.FullName</div>
                                <a href="#" class="btn btn-sm btn-dark rounded-pill mt-2 px-3" style="font-size: 10px;">Visit</a>
                            </div>
                        }
                    </div>
                    <hr />
                </div>
            }

            @* --- YOUTUBE SECTION --- *@
            <h6 class="text-uppercase text-muted small fw-bold mb-4">Latest from YouTube</h6>
            
            <div class="row">
                @if (ViewBag.YouTubeVideos != null && ((List<YouTubeVideoModel>)ViewBag.YouTubeVideos).Any())
                {
                    @foreach (var video in (List<YouTubeVideoModel>)ViewBag.YouTubeVideos)
                    {
                        <div class="col-xl-3 col-lg-4 col-md-6 col-sm-12 mb-4">
                            <div class="card border-0 bg-transparent h-100 yt-card">
                                <div class="position-relative overflow-hidden shadow-sm" style="border-radius: 12px;">
                                    <img src="@video.Thumbnail" class="card-img-top video-thumb" alt="thumbnail" style="aspect-ratio: 16/9; object-fit: cover;">
                                    <span class="badge bg-dark position-absolute bottom-0 end-0 m-2 opacity-90 fw-light" style="font-size: 11px;">YouTube</span>
                                    
                                    <div class="play-overlay d-flex align-items-center justify-content-center">
                                        <i class="fas fa-play text-white fs-2"></i>
                                    </div>

                                    <a href="https://www.youtube.com/watch?v=@video.VideoId" target="_blank" class="stretched-link"></a>
                                </div>

                                <div class="card-body px-1 pt-3 pb-0">
                                    <div class="d-flex">
                                        <div class="me-2">
                                            <img src="https://ui-avatars.com/api/?name=@video.ChannelTitle&size=36&rounded=true&background=333&color=fff" style="width: 36px; height: 36px;">
                                        </div>
                                        <div class="flex-grow-1">
                                            <h6 class="fw-bold text-dark mb-1 video-title-truncate" title="@video.Title">
                                                @Html.Raw(video.Title)
                                            </h6>
                                            <div class="text-muted" style="font-size: 13px;">
                                                <div class="channel-name">@video.ChannelTitle <i class="fas fa-check-circle ms-1" style="font-size: 10px;"></i></div>
                                                <div>@video.PublishedAt.ToString("MMM dd, yyyy")</div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="col-12 text-center py-5">
                        <i class="fab fa-youtube text-danger display-1 mb-3"></i>
                        <h5>No results found or API Quota exceeded.</h5>
                        <p class="text-muted">Please check your API key settings or try a different search term.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<style>
    .yt-card { transition: transform 0.2s ease-in-out; }
    .video-thumb { transition: transform 0.3s ease; }
    .yt-card:hover .video-thumb { transform: scale(1.05); }
    .play-overlay { position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.3); opacity: 0; transition: opacity 0.3s ease; z-index: 1; }
    .yt-card:hover .play-overlay { opacity: 1; }
    .video-title-truncate { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; font-size: 14px; line-height: 1.2; color: #0f0f0f; }
    .overflow-auto::-webkit-scrollbar { height: 5px; }
    .overflow-auto::-webkit-scrollbar-thumb { background: #ccc; border-radius: 10px; }
</style>