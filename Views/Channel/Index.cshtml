@model CodeAlpha_SocialMedia.Models.User
@{
    ViewData["Title"] = Model.FullName + "'s Channel";
    // Check karein ke login user ne isay subscribe kiya hai ya nahi
    bool isSubscribed = ViewBag.IsSubscribed ?? false;
}

<div class="container-fluid p-0" style="background-color: #f9f9f9; min-height: 100vh;">
    @* 1. Channel Banner *@
    <div class="channel-banner" style="height: 200px; background: linear-gradient(90deg, #0f0f0f, #282828); width: 100%;">
    </div>

    <div class="container mt-3">
        <div class="row align-items-center">
            @* 2. Profile Picture *@
            <div class="col-auto">
                <img src="https://ui-avatars.com/api/?name=@Model.FullName&size=120&background=random" 
                     class="rounded-circle border border-4 border-white shadow-sm" style="width: 120px; height: 120px; object-fit: cover;">
            </div>

            @* 3. Channel Info *@
            <div class="col">
                <h2 class="fw-bold mb-0">@Model.FullName</h2>
                <div class="text-muted small d-flex align-items-center gap-2">
                    <span>@@@Model.FullName.Replace(" ", "").ToLower()</span> • 
                    <span id="subCount" class="fw-bold text-dark">@ViewBag.SubscriberCount Subscribers</span> • 
                    <span>@Model.ChannelViews Views</span>
                </div>
                
                @* 4. Dynamic Subscribe & Bell Button *@
                <div class="d-flex align-items-center gap-2 mt-2">
                    <button id="subBtn" 
                            class="btn @(isSubscribed ? "btn-light border" : "btn-dark") rounded-pill px-4 fw-bold" 
                            onclick="handleSubscribe(@Model.UserId)">
                        @(isSubscribed ? "Subscribed" : "Subscribe")
                    </button>
                    
                    <button id="bellBtn" class="btn btn-light rounded-circle border @(isSubscribed ? "" : "d-none")">
                        <i class="far fa-bell"></i>
                    </button>
                </div>
            </div>
        </div>

        @* 5. Navigation Tabs *@
        <ul class="nav nav-tabs mt-5 border-0">
            <li class="nav-item">
                <a class="nav-link active fw-bold border-0 border-bottom border-3 border-dark" href="#">Home</a>
            </li>
            <li class="nav-item"><a class="nav-link text-muted border-0" href="#">Videos</a></li>
            <li class="nav-item"><a class="nav-link text-muted border-0" href="#">Shorts</a></li>
            <li class="nav-item"><a class="nav-link text-muted border-0" href="#">About</a></li>
        </ul>
        <hr class="mt-0" />

        @* 6. Real Posts Grid (YouTube Style) *@
        <div class="row mt-4">
            <h6 class="fw-bold mb-3">Recent Posts</h6>
            @if (Model.Posts != null && Model.Posts.Any())
            {
                @foreach (var post in Model.Posts.OrderByDescending(p => p.CreatedAt))
                {
                    <div class="col-xl-3 col-lg-4 col-md-6 mb-4">
                        <div class="video-card border-0 bg-transparent h-100 shadow-none cursor-pointer" onclick="playPost(@post.PostId)">
                            @* Thumbnail Style Container *@
                            <div class="ratio ratio-16x9 mb-2 rounded-3 bg-dark d-flex align-items-center justify-content-center overflow-hidden position-relative">
                                <i class="fas fa-play text-white fs-1 opacity-25"></i>
                                <span class="position-absolute bottom-0 end-0 m-2 badge bg-dark opacity-75">10:00</span> @* Placeholder time *@
                            </div>
                            
                            <div class="d-flex pt-1">
                                <img src="https://ui-avatars.com/api/?name=@Model.FullName" class="rounded-circle me-2" width="36" height="36">
                                <div class="overflow-hidden">
                                    <h6 class="fw-bold mb-1 text-dark line-clamp-2" style="font-size: 0.95rem; line-height: 1.3;">
                                        @post.Content
                                    </h6>
                                    <div class="text-muted small">
                                        @Model.FullName <br />
                                        @Model.ChannelViews views • @post.CreatedAt?.ToString("MMM dd, yyyy")
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12 text-center py-5">
                    <i class="fas fa-video-slash fs-1 text-muted mb-3"></i>
                    <p class="text-muted">No posts available on this channel.</p>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function handleSubscribe(id) {
            const btn = document.getElementById('subBtn');
            const bell = document.getElementById('bellBtn');
            const countLabel = document.getElementById('subCount');
            
            fetch('/Channel/Subscribe?channelId=' + id, { method: 'POST' })
            .then(res => res.json())
            .then(data => {
                if(data.success) {
                    if(data.isSubscribed) {
                        btn.innerText = "Subscribed";
                        btn.classList.replace('btn-dark', 'btn-light');
                        btn.classList.add('border');
                        bell.classList.remove('d-none');
                    } else {
                        btn.innerText = "Subscribe";
                        btn.classList.replace('btn-light', 'btn-dark');
                        btn.classList.remove('border');
                        bell.classList.add('d-none');
                    }
                    // Dynamic count update bina reload ke
                    countLabel.innerText = data.newCount + " Subscribers";
                }
            });
        }

        function playPost(id) {
            // Yahan aap video player ya post detail ka logic add kar sakte hain
            console.log("Playing post: " + id);
            alert("Playing content for post ID: " + id);
        }
    </script>
}

<style>
    .nav-tabs .nav-link:hover { background: none; color: #000 !important; }
    .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    .video-card { cursor: pointer; transition: 0.2s; }
    .video-card:hover .ratio { border-radius: 0px !important; }
    .cursor-pointer { cursor: pointer; }
</style>